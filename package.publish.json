{
  "name": "neuroresearch-agent",
  "version": "1.0.0",
  "description": "AI-powered neurosurgery systematic review and meta-analysis agent",
  "author": "NeuroResearch Team",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nra": "./packages/cli/dist/index.js",
    "neuroresearch": "./packages/cli/dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "neurosurgery",
    "systematic-review",
    "meta-analysis",
    "research",
    "ai",
    "claude",
    "mcp",
    "r-statistics",
    "pubmed",
    "forest-plot",
    "prisma"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neuroresearch/neuroresearch-agent"
  },
  "homepage": "https://github.com/neuroresearch/neuroresearch-agent#readme",
  "bugs": {
    "url": "https://github.com/neuroresearch/neuroresearch-agent/issues"
  },
  "files": [
    "packages/cli/dist",
    "packages/core/dist",
    "packages/mcp-servers/*/dist",
    "packages/skills/*/SKILL.md",
    "docker",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:cli": "pnpm --filter @nra/cli build",
    "build:core": "pnpm --filter @nra/core build",
    "build:mcp": "pnpm --filter '@nra/mcp-*' build",
    "dev": "pnpm --filter @nra/cli dev",
    "test": "pnpm -r test",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepublishOnly": "pnpm build",
    "docker:build": "docker build -t neuroresearch/sandbox:latest -f docker/Dockerfile.sandbox .",
    "docker:push": "docker push neuroresearch/sandbox:latest",
    "docker:run": "docker run -it --rm -v $(pwd):/workspace neuroresearch/sandbox:latest",
    "postinstall": "node scripts/postinstall.js || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.25.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "ora": "^8.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "docker": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "docker": {
      "optional": true
    }
  }
}
